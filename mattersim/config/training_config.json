{
  "description": "Default settings for the training command in README.md",
  "device": "cuda",
  "pretrained_checkpoint": "models/mattersim-v1.0.0-5M.pth",
  "data_directory": "data",
  "output_directory": "training_output",
  "cutoff": 5.0,
  "threebody_cutoff": 4.0,
  "epochs": 200,
  "batch_size": 1,
  "lr": 0.0001,
  "step_size": 10,
  "gamma": 0.95,
  "huber_delta": 0.01,
  "include_energy": true,
  "include_forces": true,
  "include_stresses": false,
  "force_loss_ratio": 1.0,
  "stress_loss_ratio": 0.0,
  "early_stop_patience": 10,
  "seed": 42,
  "re_normalize": false,
  "save_checkpoint": true,
  "ckpt_interval": 10,
  "metric_name": "val_loss",
  "gpu_memory_fraction": 0.55
}
